# Copy to `.env` in the repository root: `cp .env.example .env`
# `npm run dev` and `npm start` load it automatically; a MASTER_TOKEN already set in the
# environment takes precedence. Write the value without quotes. Never commit `.env`.
# All other settings are passed as environment variables (see README).

# Secret for the cross-session research view (/?master=<token>). If empty, a token is
# generated on first start and stored in the database. Generate one with:
#   openssl rand -hex 32
MASTER_TOKEN=

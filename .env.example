# Copy to `.env` in the repository root: `cp .env.example .env`
# `npm run dev` and `npm start` load it automatically; variables already set in the
# environment take precedence. Every variable is optional — uncomment only what you need
# (an empty value is not the same as unset). Write values without quotes, since
# `docker run --env-file` passes quotes on literally. Never commit `.env`.

# `production` suppresses request logging and the startup links containing admin keys
# and the master token.
# NODE_ENV=production

# Bind port and address.
# PORT=3001
# HOST=0.0.0.0

# Public URL of the client, used for the links logged at startup.
# CLIENT_URL=http://localhost:5173

# SQLite file; in production use an absolute path on persistent storage outside the
# repository (default: packages/server/data/ml-sortiertool.sqlite).
# DB_PATH=/var/lib/cardsort/db.sqlite

# Secret for the cross-session research view (/?master=<token>). If empty, a token is
# generated on first start and stored in the database. Generate one with:
#   openssl rand -hex 32
MASTER_TOKEN=
